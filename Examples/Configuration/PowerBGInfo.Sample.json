  "Charts": [
    {
      "Id": "cpu",
      "Title": "CPU",
      "Kind": "Sparkline",
      "Metric": "CpuPercent",
      "ValueSuffix": "%",
      "TitleColor": "#FFD700FF",
      "TitleFontWeight": 800,
      "TitleUnderlineStyle": "Double",
      "ValueColor": "#00FFFFFF",
      "ValueTextCase": "Uppercase",
      "ShowGrid": true,
      "GridLineCount": 3,
      "MaxPoints": 60,
      "Anchor": "BottomLeft",
      "OffsetX": 20,
      "OffsetY": 20
    },
    {
      "Id": "disk",
      "Title": "Disk C",
      "Kind": "Bar",
      "Metric": "DiskFreePercent",
      "MetricArgument": "C:",
      "ValueSuffix": "%",
      "ShowGrid": true,
      "GridLineCount": 3,
      "MaxPoints": 30,
      "Anchor": "BottomLeft",
      "OffsetX": 20,
      "OffsetY": 140
    }
  ]
