{
  "FilePath": "..\\Samples\\TapC-Evotec-2560x1080.jpg",
  "OutputFileName": "PowerBGInfo.Volumes.Sample.png",
  "ConfigurationDirectory": "..\\Output",
  "FontFamilyName": "Calibri",
  "Color": "#FF000000",
  "FontSize": 16,
  "ValueColor": "#FF000000",
  "ValueFontSize": 16,
  "ValueFontFamilyName": "Calibri",
  "ValueWrapWidth": 0,
  "SpaceBetweenLines": 10,
  "SpaceBetweenColumns": 50,
  "PositionX": 10,
  "PositionY": 10,
  "MonitorIndex": 0,
  "SpaceX": 10,
  "SpaceY": 10,
  "WallpaperFit": "Center",
