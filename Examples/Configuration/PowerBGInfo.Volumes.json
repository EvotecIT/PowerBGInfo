    },
    {
      "Type": "Label",
      "Name": "Volumes",
      "Color": "#FFFFFACD",
      "FontSize": 16,
      "FontFamilyName": "Calibri"
    },
    {
      "Type": "Value",
      "Name": "Drive {{DriveLetter}}",
