  "ApplyToAllUsers": false,
  "IncludeDefaultUserProfile": true,
  "UseScreenCoordinates": false,
  "ChartLayout": "Manual",
  "ChartStackAnchor": "BottomLeft",
  "ChartStackDirection": "Vertical",
  "ChartStackSpacing": 12,
